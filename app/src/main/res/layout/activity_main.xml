<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mineradio_bg">

    <!-- 内嵌 Node 服务加载的界面挂在这里；Activity 销毁时只摘不销毁 -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 启动遮罩：解压运行时 / 起服务 / 加载界面三个阶段共用 -->
    <LinearLayout
        android:id="@+id/boot_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mineradio_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.32"
            android:text="@string/app_name"
            android:textColor="@color/mineradio_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.18"
            android:text="IMMERSIVE MUSIC PLAYER"
            android:textColor="@color/mineradio_accent"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/boot_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:layout_marginTop="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/mineradio_accent"
            android:progressTint="@color/mineradio_accent" />

        <TextView
            android:id="@+id/boot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/boot_starting"
            android:textColor="@color/mineradio_text_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/boot_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/mineradio_accent"
            android:text="@string/boot_retry"
            android:textColor="@color/mineradio_bg"
            android:visibility="gone" />

        <TextView
            android:id="@+id/boot_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/boot_hint"
            android:textColor="@color/mineradio_text_dim"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
